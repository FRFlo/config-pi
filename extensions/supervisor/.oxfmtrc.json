{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "bun.lockb",
    "node_modules/"
  ]
}
