{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "packages": [
    "git:github.com/FRFlo/pi-web-search",
    "git:github.com/code-yeongyu/pi-apply-patch",
    "git:github.com/FRFlo/pi-todotools",
    "git:github.com/FRFlo/pi-quotas",
    "npm:pi-antigravity",
    "npm:pi-lsp",
    "npm:@tintinweb/pi-subagents"
  ],
  "observational-memory": {
    "backend": "sqlite",
    "models": {
      "observer": {
        "provider": "antigravity",
        "id": "gemini-3.7-flash"
      },
      "consolidator": {
        "provider": "antigravity",
        "id": "gemini-3.7-flash"
      }
    }
  },
  "terminal": {
    "notify": "next-turn"
  },
  "hideThinkingBlock": true,
  "defaultTools": [
    "+codemode"
  ]
