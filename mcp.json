{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "directTools": true
    },
    "svelte": {
      "command": "bunx",
      "args": [
        "-y",
        "@sveltejs/mcp"
      ]
    },
    "gitnexus": {
      "command": "bunx",
      "args": [
        "-y",
        "gitnexus",
        "mcp"
      ]
    },
    "grep_app": {
      "url": "https://mcp.grep.app",
      "directTools": true
    },
    "cloudflare-api": {
      "url": "https://mcp.cloudflare.com/mcp",
      "directTools": true
    },
    "cloudflare-browser": {
      "url": "https://browser.mcp.cloudflare.com/mcp",
      "directTools": true
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp",
      "auth": "oauth"
    },
    "executor": {
      "url": "https://your-executor-url.example.com",
      "directTools": true
    }
  }
}
