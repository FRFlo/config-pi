{
  "version": 1,
  "servers": [
    {
      "id": "lugo-lua",
      "enabled": true,
      "include": ["**/*.lua"],
      "rootMarkers": ["fxmanifest.lua", "__resource.lua", ".luarc.json", ".git"],
      "bin": "./bin/lugo.exe",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": { ".lua": "lua" },
      "startupTimeoutMs": 60000,
      "diagnosticsWaitMs": 1500,
      "initializationOptions": {
        "diagFiveMEventDirection": true,
        "diagFiveMEventPayload": true,
        "diagFiveMUnregisteredNetEvent": true,
        "diagFiveMUnknownEvent": true,
        "diagFiveMUnaccountedFile": true,
        "diagFiveMUnknownExport": true,
        "diagFiveMUnknownResource": true,
        "diagFiveMTrustBoundary": true,
        "diagFiveMPerformance": true,
        "diagFiveMSQL": true
      },
      "settings": {}
    },
    {
      "id": "bun-typescript",
      "enabled": true,
      "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mts", "**/*.cts", "**/*.mjs", "**/*.cjs"],
      "rootMarkers": ["bun.lock", "bunfig.toml", "package.json", "tsconfig.json"],
      "bin": "bun",
      "args": ["x", "typescript-language-server", "--stdio"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1500,
      "initializationOptions": {},
      "settings": {}
    },
    {
      "id": "python-pyright",
      "enabled": true,
      "include": ["**/*.py", "**/*.pyi"],
      "rootMarkers": ["pyproject.toml", "setup.py", "requirements.txt", "pyrightconfig.json"],
      "bin": "bun",
      "args": ["x", "pyright-langserver", "--stdio"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".py": "python",
        ".pyi": "python"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 2000,
      "initializationOptions": {},
      "settings": {}
    },
    {
      "id": "gopls",
      "enabled": true,
      "include": ["**/*.go"],
      "rootMarkers": ["go.mod", "go.work"],
      "bin": "gopls",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": { ".go": "go" },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1500,
      "initializationOptions": {},
      "settings": {}
    },
    {
      "id": "csharp-ls",
      "enabled": true,
      "include": ["**/*.cs"],
      "rootMarkers": ["*.sln", "*.slnx", "*.csproj", "global.json"],
      "bin": "~/.dotnet/tools/csharp-ls.exe",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": { ".cs": "csharp" },
      "startupTimeoutMs": 60000,
      "diagnosticsWaitMs": 2000,
      "initializationOptions": {},
      "settings": {}
    },
    {
      "id": "jdtls",
      "enabled": true,
      "include": ["**/*.java"],
      "rootMarkers": ["pom.xml", "build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts", ".project", ".git"],
      "bin": "~/AppData/Roaming/npm/jdtls",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": { ".java": "java" },
      "startupTimeoutMs": 90000,
      "diagnosticsWaitMs": 2000,
      "initializationOptions": {},
      "settings": {}
    }
  ]
}
